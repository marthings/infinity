<header class="home-hero native-inset-top">
  <h1>Infinity</h1>
  <%= render "quick_form", capture: @capture %>
</header>

<section class="capture-page native-home-page">
  <%= turbo_stream_from [ Current.user, :captures ] %>

  <% if @captures.any? %>
    <div class="capture-list">
      <%= render @captures %>
    </div>
  <% else %>
    <p>No captures yet.</p>
  <% end %>
</section>
