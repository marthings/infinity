<section class="capture-page">
  <%= native_navbar_tag("Infinity") %>

  <header class="page-header">
    <h1 class="native-hidden">Infinity</h1>
  </header>

  <%= render "quick_form", capture: @capture %>

  <% if @captures.any? %>
    <div class="capture-list">
      <%= render @captures %>
    </div>
  <% else %>
    <p>No captures yet.</p>
  <% end %>
</section>
