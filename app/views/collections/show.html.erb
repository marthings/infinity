<section class="capture-page">
  <%= native_navbar_tag(@collection.name) %>

  <header class="page-header">
    <h1 class="native-hidden"><%= @collection.name %></h1>
    <%= link_to "Back to collections", collections_path, class: "native-hidden" %>
  </header>

  <% if @captures.any? %>
    <div class="capture-list">
      <%= render @captures %>
    </div>
  <% else %>
    <p>No captures in this collection yet.</p>
  <% end %>

  <nav class="capture-actions" aria-label="Collection actions">
    <%= link_to "Edit", edit_collection_path(@collection) %>
    <%= button_to "Delete", @collection, method: :delete, form: { data: { turbo_confirm: "Delete this collection?" } } %>
  </nav>
</section>
