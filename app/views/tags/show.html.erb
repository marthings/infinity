<section class="capture-page">
  <%= native_navbar_tag(@tag.name) %>

  <header class="page-header">
    <h1 class="native-hidden"><%= @tag.name %></h1>
    <%= link_to "Back to tags", tags_path, class: "native-hidden" %>
  </header>

  <% if @captures.any? %>
    <div class="capture-list">
      <%= render @captures %>
    </div>
  <% else %>
    <p>No captures with this tag yet.</p>
  <% end %>

  <nav class="capture-actions" aria-label="Tag actions">
    <%= link_to "Edit", edit_tag_path(@tag) %>
    <%= button_to "Delete", @tag, method: :delete, form: { data: { turbo_confirm: "Delete this tag?" } } %>
  </nav>
</section>
