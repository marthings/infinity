<h1>Forgot your password?</h1>

<%= tag.div(flash[:alert], role: "alert") if flash[:alert] %>

<%= form_with url: passwords_path do |form| %>
  <p>
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], placeholder: "name@example.com" %>
  </p>

  <p><%= form.submit "Email reset instructions" %></p>
<% end %>
