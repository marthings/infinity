<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Infinity" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Infinity">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      href="https://fonts.googleapis.com/css2?family=Prata&family=Stack+Sans+Notch:wght@200..700&display=swap"
      rel="stylesheet"
    >

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :ruby_native, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% unless native_app? %>
      <header class="application-header">
        <div class="application-navigation">
          <%= link_to "Infinity", root_path, class: "application-brand" %>

          <button
            class="menu-toggle"
            type="button"
            aria-label="Open navigation"
            popovertarget="application-menu"
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>

          <nav id="application-menu" class="application-menu" aria-label="Primary navigation" popover="auto">
            <%= link_to "Home", root_path %>
            <%= link_to "Collections", collections_path %>
            <%= link_to "Profile", profile_path %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="native-inset">
      <%= yield %>
    </main>

    <%= native_tabs_tag if authenticated? %>
    <%= native_identity_tag Current.user&.id %>
  </body>
</html>
