<section class="profile-page">
  <%= native_form_tag %>
  <%= native_navbar_tag("Profile") %>

  <header class="page-header">
    <h1 class="native-hidden">Profile</h1>
  </header>

  <%= form_with model: @user, url: profile_path, scope: :profile, class: "profile-form" do |form| %>
    <% if @user.errors.any? %>
      <section class="form-errors" role="alert" aria-labelledby="profile-errors-title">
        <h2 id="profile-errors-title"><%= pluralize(@user.errors.count, "error") %> prevented your profile from being saved</h2>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <p class="field">
      <%= form.label :email_address %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "name@example.com" %>
    </p>

    <fieldset class="profile-password-fields">
      <legend>Change password</legend>

      <p class="field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, autocomplete: "new-password", placeholder: "Leave blank to keep your password" %>
      </p>

      <p class="field">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repeat your new password" %>
      </p>
    </fieldset>

    <p><%= form.submit "Save profile" %></p>
  <% end %>

  <section class="phone-save" aria-labelledby="phone-save-title">
    <h2 id="phone-save-title">Save from your phone</h2>
    <p>Stay signed in, then share an HTTP or HTTPS link to this address. Infinity saves it to your private library.</p>
    <p><code><%= share_url %>?url=LINK</code></p>
    <ol>
      <li>Create an iOS Shortcut that receives URLs and opens the address above with the shared link in place of <code>LINK</code>.</li>
      <li>From Safari or another app, tap Share and choose that Shortcut.</li>
      <li>On Android, a share that sends the URL as <code>url</code> or <code>text</code> can open the same address.</li>
    </ol>
    <p>Infinity does not appear as a system share-sheet app yet. Use the Shortcut for one-tap save until it does.</p>
  </section>
</section>
